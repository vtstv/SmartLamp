<Window x:Class="SmartLampApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Lamp Studio by Murr" Height="770" Width="960"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI, Segoe UI Emoji">

    <Window.Resources>
        <!-- Full Custom ControlTemplate for ComboBox (Overrides Windows Default Light Gray Theme) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid">
                <ToggleButton x:Name="ToggleButton"
                              Focusable="false"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="templateFrame" Background="#0C0C14" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="templateFrame" Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="10,4,26,4" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="#161626" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Margin="0,2,0,0">
                            <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0066CC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded Glass Button -->
        <Style x:Key="GlassBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Power Button Style -->
        <Style x:Key="PowerBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Color Swatch Style -->
        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="#44ffffff" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border Frame (Zero Scrollbars!) -->
    <Border Background="#0C0C14" CornerRadius="16" BorderBrush="#222234" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- App Header -->
                <RowDefinition Height="Auto"/> <!-- Nav Pills -->
                <RowDefinition Height="*"/>    <!-- Content Area -->
                <RowDefinition Height="36"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="#12121E" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtAppTitle" Text="SmartLamp Studio" FontSize="12" FontWeight="Bold" Foreground="#8888AA"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="24" Style="{StaticResource GlassBtn}" Background="Transparent" Foreground="#AAAAAA" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="30" Height="24" Style="{StaticResource GlassBtn}" Background="Transparent" Foreground="#AAAAAA" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main App Header & Multi-Device Selector -->
            <Border Grid.Row="1" Background="#161626" Margin="14,8,14,6" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dynamic Ambient Light Bulb Icon -->
                    <Border x:Name="BulbGlowFrame" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#2A2A3E" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtBulbIcon" Text="💡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Device:" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDeviceSelector" Width="260" Height="28" Margin="10,0,0,0"
                                      Template="{StaticResource DarkComboBoxTemplate}"
                                      SelectionChanged="CmbDeviceSelector_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDeviceInfo" Text="IP: Select or Add Device  |  ID: --" FontSize="11" Foreground="#AAAAAA" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Harmonious Natural Emerald Online Status Pill -->
                    <Border x:Name="PillStatus" Grid.Column="2" Background="#10B981" CornerRadius="10" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="🟢 ONLINE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Navigation Bar (Pill Buttons) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,6">
                <Button x:Name="NavDash" Content="💡 Control Dashboard" Width="170" Height="34" Style="{StaticResource GlassBtn}" Background="#00F0FF" Foreground="#000000" FontWeight="Bold" Margin="0,0,6,0" Click="NavDash_Click"/>
                <Button x:Name="NavSettings" Content="⚙️ Settings &amp; Hotkeys" Width="170" Height="34" Style="{StaticResource GlassBtn}" Background="#1F1F30" Foreground="#AAAAAA" Margin="0,0,6,0" Click="NavSettings_Click"/>
                <Button x:Name="NavGoogleHome" Content="🌐 Google Home" Width="140" Height="34" Style="{StaticResource GlassBtn}" Background="#1F1F30" Foreground="#AAAAAA" Margin="0,0,6,0" Click="NavGoogleHome_Click"/>
                <Button x:Name="NavMqtt" Content="🤖 Home Assistant &amp; MQTT" Width="190" Height="34" Style="{StaticResource GlassBtn}" Background="#1F1F30" Foreground="#AAAAAA" Click="NavMqtt_Click"/>
            </StackPanel>

            <!-- 4. Content Area (2-Column Grid, ZERO SCROLLING!) -->
            <Grid Grid.Row="3" Margin="14,0,14,0">
                <!-- VIEW 1: CONTROL DASHBOARD -->
                <Grid x:Name="ViewDashboard" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Power, Brightness, Temp & Custom Sleep Timer -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <!-- Hero Power Card (Natural Harmonious Emerald Tone #10B981) -->
                        <Border Background="#161626" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <Button x:Name="BtnPower" Content="⚡ POWERED ON" Height="48" Style="{StaticResource PowerBtnStyle}"
                                    Background="#10B981" Click="BtnPower_Click"/>
                        </Border>

                        <!-- Sleep Timer Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="⏳ Sleep Timer (Auto Off)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtTimerStatus" Text="Off" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <!-- Preset Buttons -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="15m" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Tag="15" Click="BtnSetTimer_Click"/>
                                    <Button Grid.Column="1" Content="30m" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Tag="30" Click="BtnSetTimer_Click"/>
                                    <Button Grid.Column="2" Content="45m" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Tag="45" Click="BtnSetTimer_Click"/>
                                    <Button Grid.Column="3" Content="60m" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Tag="60" Click="BtnSetTimer_Click"/>
                                    <Button Grid.Column="4" Content="✕ Off" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#DC3545" Click="BtnCancelTimer_Click"/>
                                </Grid>

                                <!-- Custom Duration Input -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomTimerMins" Grid.Column="0" Text="20" Height="24" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#00F0FF" FontWeight="Bold" BorderBrush="#222236" Padding="6,0"/>
                                    <Button Grid.Column="1" Content="⚡ Set Custom Mins" Width="130" Height="24" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Background="#0066CC" Click="BtnSetCustomTimer_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Brightness Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="☀️ Brightness Level" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtBrightVal" Text="50%" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderBright" Minimum="1" Maximum="100" Value="50" Margin="0,6,0,6" ValueChanged="SliderBright_ValueChanged"/>
                                <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <Button Grid.Column="0" Content="1%" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnB1_Click"/>
                                    <Button Grid.Column="1" Content="25%" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnB25_Click"/>
                                    <Button Grid.Column="2" Content="50%" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnB50_Click"/>
                                    <Button Grid.Column="3" Content="75%" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnB75_Click"/>
                                    <Button Grid.Column="4" Content="100%" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnB100_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Color Temp Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="🌡️ Color Temperature" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtTempVal" Text="4000K" FontSize="12" FontWeight="Bold" Foreground="#FFB347" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderTemp" Minimum="2700" Maximum="6500" Value="4000" Margin="0,6,0,6" ValueChanged="SliderTemp_ValueChanged"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Warm 2700K" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnT2700_Click"/>
                                    <Button Grid.Column="1" Content="Neutral 4000K" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnT4000_Click"/>
                                    <Button Grid.Column="2" Content="Cool 6500K" Margin="1" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnT6500_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Color Palette & Scenes -->
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <!-- RGB Color Palette Card with Color Picker -->
                        <Border Background="#161626" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎨 RGB Color Palette" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <!-- Row 1: Warm & Green Tones -->
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF1744" Tag="#FF1744" Click="BtnColor_Click" ToolTip="Red"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF5252" Tag="#FF5252" Click="BtnColor_Click" ToolTip="Coral"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF9100" Tag="#FF9100" Click="BtnColor_Click" ToolTip="Orange"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFC400" Tag="#FFC400" Click="BtnColor_Click" ToolTip="Amber"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFEA00" Tag="#FFEA00" Click="BtnColor_Click" ToolTip="Yellow"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#76FF03" Tag="#76FF03" Click="BtnColor_Click" ToolTip="Lime"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#10B981" Tag="#10B981" Click="BtnColor_Click" ToolTip="Emerald"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#00E676" Tag="#00E676" Click="BtnColor_Click" ToolTip="Mint"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#1DE9B6" Tag="#1DE9B6" Click="BtnColor_Click" ToolTip="Teal"/>

                                    <!-- Row 2: Cool & Purple Tones -->
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#00E5FF" Tag="#00E5FF" Click="BtnColor_Click" ToolTip="Cyan"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#00B0FF" Tag="#00B0FF" Click="BtnColor_Click" ToolTip="Sky Blue"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#2979FF" Tag="#2979FF" Click="BtnColor_Click" ToolTip="Royal Blue"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#3D5AFE" Tag="#3D5AFE" Click="BtnColor_Click" ToolTip="Indigo"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#651FFF" Tag="#651FFF" Click="BtnColor_Click" ToolTip="Deep Purple"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#D500F9" Tag="#D500F9" Click="BtnColor_Click" ToolTip="Magenta"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#F50057" Tag="#F50057" Click="BtnColor_Click" ToolTip="Hot Pink"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFE0B2" Tag="#FFE0B2" Click="BtnColor_Click" ToolTip="Warm Soft White"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFFFFF" Tag="#FFFFFF" Click="BtnColor_Click" ToolTip="Pure White"/>
                                </WrapPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtHexCode" Grid.Column="0" Text="#00E5FF" FontSize="13" Height="30" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#00F0FF" FontWeight="Bold" BorderBrush="#222236" Padding="8,0"/>
                                    <Button Grid.Column="1" Content="🎨 Color Studio" Width="105" Height="30" Margin="6,0,0,0" Style="{StaticResource GlassBtn}" Background="#651FFF" Click="BtnColorPicker_Click"/>
                                    <Button Grid.Column="2" Content="Apply" Width="70" Height="30" Margin="6,0,0,0" Style="{StaticResource GlassBtn}" Background="#0066CC" Click="BtnApplyHex_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lighting Scenes Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="✨ Lighting Scenes" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <UniformGrid Columns="3">
                                    <Button Content="🌙 Night" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Night" Click="BtnScene_Click"/>
                                    <Button Content="📖 Read" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Reading" Click="BtnScene_Click"/>
                                    <Button Content="💻 Focus" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Working" Click="BtnScene_Click"/>
                                    <Button Content="🛋️ Relax" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Relax" Click="BtnScene_Click"/>
                                    <Button Content="🎉 Party" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Party" Click="BtnScene_Click"/>
                                    <Button Content="🌈 Cycle" Height="32" Margin="2" Style="{StaticResource GlassBtn}" Background="#222236" Tag="Rainbow" Click="BtnScene_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- VIEW 2: DEVICE SETTINGS & WINDOW EXIT BEHAVIOR -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Credentials, Save/Delete Device & Exit Behavior -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <!-- Device Credentials Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="14" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="📌 Device Credentials &amp; Group" FontSize="14" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,10"/>

                                <TextBlock Text="Device Name:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,2,0,1"/>
                                <TextBox x:Name="TxtName" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236" Padding="6,0"/>

                                <TextBlock Text="IP Address:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,4,0,1"/>
                                <TextBox x:Name="TxtIp" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236" Padding="6,0"/>

                                <TextBlock Text="Device ID:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,4,0,1"/>
                                <TextBox x:Name="TxtDevId" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236" Padding="6,0"/>

                                <!-- MASKED LOCAL KEY WITH EYE TOGGLE BUTTON -->
                                <TextBlock Text="Local Key (16 Chars):" FontSize="11" FontWeight="Bold" Foreground="#FFEA00" Margin="0,4,0,1"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PassLocalKey" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFEA00" FontWeight="Bold" BorderBrush="#FFEA00" Padding="6,0"/>
                                    <TextBox x:Name="TxtLocalKeyVisible" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFEA00" FontWeight="Bold" BorderBrush="#FFEA00" Padding="6,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnToggleKeyVisibility" Grid.Column="1" Content="👁️" Width="34" Height="26" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnToggleKeyVisibility_Click"/>
                                </Grid>

                                <TextBlock Text="Group Name (e.g. Living Room):" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,4,0,1"/>
                                <TextBox x:Name="TxtGroup" Height="26" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236" Padding="6,0"/>

                                <!-- Save Device & Delete Device Buttons Grid -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnSaveDevice" Grid.Column="0" Content="💾 Save Device" Height="30" Style="{StaticResource GlassBtn}" Background="#0066CC" Click="BtnSaveDevice_Click"/>
                                    <Button x:Name="BtnDeleteDevice" Grid.Column="1" Content="🗑️ Delete" Width="90" Height="30" Margin="6,0,0,0" Style="{StaticResource GlassBtn}" Background="#DC3545" Click="BtnDeleteDevice_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- APP BEHAVIOR & INTEGRATIONS CARD -->
                        <Border Background="#161626" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="⚙️ App Behavior &amp; Integrations" FontSize="13" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkCloseToTray" Content="Minimize to System Tray on window close (✕)"
                                          Foreground="#FFFFFF" FontWeight="Bold" IsChecked="True"
                                          Click="ChkConfigToggle_Click" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkEnableGoogle" Content="Enable Google Home Bridge Integration"
                                          Foreground="#FFFFFF" FontWeight="Bold" IsChecked="False"
                                          Click="ChkConfigToggle_Click" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkEnableMqtt" Content="Enable Home Assistant &amp; MQTT Bridge"
                                          Foreground="#FFFFFF" FontWeight="Bold" IsChecked="False"
                                          Click="ChkConfigToggle_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Custom Hotkey Picker, Auto-Discovery & Masked Cloud Access Key -->
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <!-- CUSTOM HOTKEY PICKER CARD -->
                        <Border Background="#161626" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="⌨️ Custom Global Windows Hotkey" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkCtrl" Content="Ctrl" Foreground="#FFFFFF" FontWeight="Bold" IsChecked="True" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="ChkAlt" Content="Alt" Foreground="#FFFFFF" FontWeight="Bold" IsChecked="True" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="ChkShift" Content="Shift" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbHotkeyKey" Width="64" Height="24" Template="{StaticResource DarkComboBoxTemplate}"/>
                                </StackPanel>
                                <Button x:Name="BtnSaveHotkey" Content="💾 Register &amp; Save Hotkey" Height="26" Style="{StaticResource GlassBtn}" Background="#651FFF" Click="BtnSaveHotkey_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto Discovery Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="🔍 Wi-Fi Auto-Discovery" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
                                <Button x:Name="BtnAutoDiscover" Content="⚡ Scan Local Wi-Fi Subnet" Height="26" Style="{StaticResource GlassBtn}" Background="#10B981" Click="BtnAutoDiscover_Click"/>
                                
                                <ListBox x:Name="LstDiscovered" Height="65" Margin="0,4,0,0" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236"
                                         SelectionChanged="LstDiscovered_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Tuya Cloud Sync Card -->
                        <Border Background="#161626" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="☁️ Auto-Fetch Key from Tuya Cloud" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="Access ID:" FontSize="10" Foreground="#AAAAAA"/>
                                        <TextBox x:Name="TxtAccId" Height="24" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFFFFF" BorderBrush="#222236"/>
                                    </StackPanel>

                                    <!-- MASKED ACCESS KEY WITH EYE TOGGLE -->
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                        <TextBlock Text="Access Key (Secret):" FontSize="10" Foreground="#AAAAAA"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="PassAccKey" Grid.Column="0" Height="24" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFEA00" FontWeight="Bold" BorderBrush="#222236" Padding="4,0"/>
                                            <TextBox x:Name="TxtAccKeyVisible" Grid.Column="0" Height="24" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#FFEA00" FontWeight="Bold" BorderBrush="#222236" Padding="4,0" Visibility="Collapsed"/>
                                            <Button x:Name="BtnToggleAccKeyVisibility" Grid.Column="1" Content="👁️" Width="28" Height="24" Margin="3,0,0,0" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnToggleAccKeyVisibility_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnCloudFetch" Grid.Column="0" Content="⚡ Fetch Key from Cloud" Height="26" Style="{StaticResource GlassBtn}" Background="#0066CC" Click="BtnCloudFetch_Click"/>
                                    <Button x:Name="BtnTuyaGuide" Grid.Column="1" Content="❓ Instructions" Width="95" Height="26" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnTuyaGuide_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- VIEW 3: GOOGLE SMART HOME INTEGRATION -->
                <Grid x:Name="ViewGoogleHome" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Border Background="#161626" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🌐 Google Smart Home Local Bridge" FontSize="14" FontWeight="Bold" Foreground="#4285F4" Margin="0,0,0,10"/>
                                <TextBlock Text="Integrate your Smart Lamp with Google Home &amp; Assistant ecosystem via Local Home SDK / REST Webhook Bridge." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Border x:Name="PillGoogleStatus" Background="#10B981" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtGoogleStatus" Text="🟢 Bridge Active on Port 8088" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>

                                <TextBlock Text="Local Webhook URL:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,4,0,2"/>
                                <TextBox Text="http://localhost:8088/google-smart-home/" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#00F0FF" BorderBrush="#222236" Padding="6,0"/>

                                <Button x:Name="BtnStartGoogleBridge" Content="⚡ Restart Google Home Bridge" Height="36" Margin="0,14,0,0" Style="{StaticResource GlassBtn}" Background="#4285F4" Click="BtnStartGoogleBridge_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <Border Background="#161626" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🗣️ Google Assistant Voice Simulator" FontSize="14" FontWeight="Bold" Foreground="#EA4335" Margin="0,0,0,10"/>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Button Content="🗣️ 'Turn On Lamp'" Height="34" Margin="3" Style="{StaticResource GlassBtn}" Background="#10B981" Click="BtnGoogleTestOn_Click"/>
                                    <Button Content="🗣️ 'Turn Off Lamp'" Height="34" Margin="3" Style="{StaticResource GlassBtn}" Background="#DC3545" Click="BtnGoogleTestOff_Click"/>
                                </UniformGrid>

                                <TextBlock Text="Google Assistant Event Log:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtGoogleLog" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0C0C14" Foreground="#10B981" FontFamily="Consolas" FontSize="11" Padding="6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- VIEW 4: HOME ASSISTANT & MQTT INTEGRATION -->
                <Grid x:Name="ViewMqtt" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Border Background="#161626" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🤖 Home Assistant &amp; MQTT Bridge" FontSize="14" FontWeight="Bold" Foreground="#03A9F4" Margin="0,0,0,10"/>
                                <TextBlock Text="Native Home Assistant MQTT Auto-Discovery &amp; REST Bridge Server on Port 1883." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Border x:Name="PillMqttStatus" Background="#10B981" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtMqttStatus" Text="🟢 HA Bridge Active on Port 1883" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>

                                <TextBlock Text="Home Assistant Webhook Endpoint:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,4,0,2"/>
                                <TextBox Text="http://localhost:1883/mqtt/" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Background="#0C0C14" Foreground="#00F0FF" BorderBrush="#222236" Padding="6,0"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnStartMqttBridge" Grid.Column="0" Content="⚡ Restart HA Bridge" Height="36" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Background="#03A9F4" Click="BtnStartMqttBridge_Click"/>
                                    <Button x:Name="BtnCopyMqttDiscovery" Grid.Column="1" Content="📋 Copy HA Discovery JSON" Height="36" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Background="#651FFF" Click="BtnCopyMqttDiscovery_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <Border Background="#161626" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🤖 Home Assistant Event Simulator" FontSize="14" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,10"/>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Button Content="🤖 HA: 'Turn ON'" Height="34" Margin="3" Style="{StaticResource GlassBtn}" Background="#10B981" Click="BtnMqttTestOn_Click"/>
                                    <Button Content="🤖 HA: 'Turn OFF'" Height="34" Margin="3" Style="{StaticResource GlassBtn}" Background="#DC3545" Click="BtnMqttTestOff_Click"/>
                                </UniformGrid>

                                <TextBlock Text="Home Assistant &amp; MQTT Log:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtMqttLog" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0C0C14" Foreground="#10B981" FontFamily="Consolas" FontSize="11" Padding="6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 5. Footer (With Custom Hotkey Display & Icon) -->
            <Border Grid.Row="4" Background="#12121E" CornerRadius="0,0,16,16" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="🔄 Refresh" Width="90" Height="24" Style="{StaticResource GlassBtn}" Background="#222236" Click="BtnRefresh_Click"/>
                        <Border Background="#1F1F30" CornerRadius="6" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtFooterHotkey" Text="⌨️ Hotkey: Ctrl+Alt+L" FontSize="11" Foreground="#00F0FF" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    
                    <Button x:Name="BtnAuthor" Content="© 2026 Murr (https://github.com/vtstv)" HorizontalAlignment="Right" Background="Transparent" Foreground="#777799" BorderThickness="0" Cursor="Hand" Click="BtnAuthor_Click"/>
                </Grid>
            </Border>

            <!-- 6. Custom Dark Glassmorphic Modal Overlay: Tuya Cloud Guide -->
            <Grid x:Name="OverlayTuyaGuide" Grid.RowSpan="5" Visibility="Collapsed" Background="#E50A0A14">
                <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#161626" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="How to Get Access ID &amp; Key in Tuya Cloud" FontSize="15" FontWeight="Bold" Foreground="#00F0FF"/>
                            </StackPanel>
                            <Button Content="✕" Width="26" Height="26" HorizontalAlignment="Right" Style="{StaticResource GlassBtn}" Background="#222236" Foreground="#AAAAAA" Click="BtnCloseTuyaGuide_Click"/>
                        </Grid>

                        <!-- Step-by-Step Instructions in English -->
                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                            <StackPanel TextElement.Foreground="#DDDDDD" TextElement.FontSize="12">
                                <Border Background="#0C0C14" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="Bold" Foreground="#00F0FF">1️⃣ Register on Tuya IoT Portal:</Run>
                                        <LineBreak/>
                                        Go to <Run Foreground="#FFEA00">https://iot.tuya.com</Run> and create a free developer account.
                                    </TextBlock>
                                </Border>

                                <Border Background="#0C0C14" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="Bold" Foreground="#00F0FF">2️⃣ Create a Cloud Project:</Run>
                                        <LineBreak/>
                                        Navigate to <Run Foreground="#10B981">Cloud -&gt; Development -&gt; Create Cloud Project</Run>. Choose your data center region (e.g. Europe).
                                    </TextBlock>
                                </Border>

                                <Border Background="#0C0C14" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="Bold" Foreground="#00F0FF">3️⃣ Authorize IoT Core API:</Run>
                                        <LineBreak/>
                                        In your Cloud Project, go to <Run Foreground="#10B981">Service API</Run> tab, click <Run Foreground="#FFEA00">Go to Authorize</Run> and subscribe to the <Run Foreground="#00F0FF">IoT Core API</Run>.
                                    </TextBlock>
                                </Border>

                                <Border Background="#0C0C14" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="Bold" Foreground="#00F0FF">4️⃣ Link Your Smart Life App Account:</Run>
                                        <LineBreak/>
                                        Go to <Run Foreground="#10B981">Devices -&gt; Link Tuya App Account -&gt; Add App Account</Run>. Scan the displayed QR code using your <Run Foreground="#FFEA00">Smart Life / Tuya Smart</Run> mobile app (Profile -&gt; QR Scanner).
                                    </TextBlock>
                                </Border>

                                <Border Background="#0C0C14" CornerRadius="8" Padding="12" Margin="0,0,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="Bold" Foreground="#00F0FF">5️⃣ Copy Your Credentials:</Run>
                                        <LineBreak/>
                                        Go back to your Project <Run Foreground="#10B981">Overview</Run> page and copy:
                                        <LineBreak/>
                                        • <Run FontWeight="Bold" Foreground="#FFEA00">Client ID</Run> (Access ID)
                                        <LineBreak/>
                                        • <Run FontWeight="Bold" Foreground="#FFEA00">Client Secret</Run> (Access Key)
                                        <LineBreak/><LineBreak/>
                                        Paste them into the fields and click <Run Foreground="#0066CC">Fetch Key from Cloud</Run>!
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Close Button -->
                        <Button Content="Got it!" Height="32" Style="{StaticResource GlassBtn}" Background="#0066CC" FontWeight="Bold" Click="BtnCloseTuyaGuide_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
