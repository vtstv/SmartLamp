<Window x:Class="SmartLampApp.Services.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Studio" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI, Segoe UI Emoji">

    <Border Background="#12121E" CornerRadius="16" BorderBrush="#00F0FF" BorderThickness="1.5">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="🎨 Interactive Color Studio" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Button Content="✕" Width="26" Height="24" HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            </Grid>

            <!-- Main Pickers Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Clickable Spectrum Bar & Canvas -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Click or Drag on Rainbow Spectrum:" FontSize="11" FontWeight="Bold" Foreground="#8888AA" Margin="0,0,0,4"/>
                    
                    <!-- CLICKABLE INTERACTIVE SPECTRUM BAR -->
                    <Border x:Name="SpectrumBar" Height="32" CornerRadius="8" Cursor="Hand" BorderBrush="#44FFFFFF" BorderThickness="1"
                            MouseDown="SpectrumBar_MouseDown" MouseMove="SpectrumBar_MouseMove" MouseUp="SpectrumBar_MouseUp">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0.0"/>
                                <GradientStop Color="#FFFF00" Offset="0.16"/>
                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.66"/>
                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                <GradientStop Color="#FF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Quick Palette Grid -->
                    <TextBlock Text="Quick Preset Palette:" FontSize="11" FontWeight="Bold" Foreground="#8888AA" Margin="0,12,0,6"/>
                    <UniformGrid Columns="6">
                        <Button Height="30" Margin="2" Background="#FF1744" BorderThickness="0" Cursor="Hand" Tag="#FF1744" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#FF9100" BorderThickness="0" Cursor="Hand" Tag="#FF9100" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#FFEA00" BorderThickness="0" Cursor="Hand" Tag="#FFEA00" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#00E676" BorderThickness="0" Cursor="Hand" Tag="#00E676" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#00E5FF" BorderThickness="0" Cursor="Hand" Tag="#00E5FF" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#2979FF" BorderThickness="0" Cursor="Hand" Tag="#2979FF" Click="BtnPresetColor_Click"/>

                        <Button Height="30" Margin="2" Background="#651FFF" BorderThickness="0" Cursor="Hand" Tag="#651FFF" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#F50057" BorderThickness="0" Cursor="Hand" Tag="#F50057" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#FF007F" BorderThickness="0" Cursor="Hand" Tag="#FF007F" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#7F00FF" BorderThickness="0" Cursor="Hand" Tag="#7F00FF" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#FFD700" BorderThickness="0" Cursor="Hand" Tag="#FFD700" Click="BtnPresetColor_Click"/>
                        <Button Height="30" Margin="2" Background="#FFFFFF" BorderThickness="0" Cursor="Hand" Tag="#FFFFFF" Click="BtnPresetColor_Click"/>
                    </UniformGrid>

                    <TextBlock Text="Brightness:" FontSize="11" FontWeight="Bold" Foreground="#8888AA" Margin="0,10,0,2"/>
                    <Slider x:Name="SliderVal" Minimum="10" Maximum="100" Value="100" ValueChanged="Slider_ValueChanged"/>
                </StackPanel>

                <!-- Right Column: Live Color Preview Box & Hex Text -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Selected Color" FontSize="11" FontWeight="Bold" Foreground="#8888AA" Margin="0,0,0,4"/>
                    <Border x:Name="ColorPreviewFrame" Height="110" CornerRadius="12" Background="#00E5FF" BorderBrush="#44FFFFFF" BorderThickness="2" Margin="0,0,0,8"/>
                    
                    <TextBlock x:Name="TxtSelectedHex" Text="#00E5FF" FontSize="15" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Footer Action Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="✕ Cancel" Height="36" Margin="0,0,6,0" Background="#222236" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Grid.Column="1" Content="✓ Select Color" Height="36" Margin="6,0,0,0" Background="#00F0FF" Foreground="#000000" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSelect_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
