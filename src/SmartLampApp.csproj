<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app_icon.png" />
    <Resource Include="Assets/app_icon.ico" />
    <EmbeddedResource Include="Assets/app_icon.ico" />
    <EmbeddedResource Include="TuyaBridge\tuya_bridge.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="kwolo.tuya.net" Version="1.0.5" />
    <PackageReference Include="TuyaNet" Version="1.0.3" />
  </ItemGroup>

</Project>
