<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <Version>3.0.1</Version>
    <AssemblyVersion>3.0.1.0</AssemblyVersion>
    <FileVersion>3.0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app_icon.png" />
    <Resource Include="Assets/app_icon.ico" />
    <EmbeddedResource Include="Assets/app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SmartLamp.Cli\**" />
    <Compile Remove="SmartLamp.Desktop\**" />
    <None Remove="SmartLamp.Cli\**" />
    <None Remove="SmartLamp.Desktop\**" />
    <Page Remove="SmartLamp.Desktop\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\TuyaNet.Native\TuyaNet.Native.csproj" />
  </ItemGroup>

</Project>
